MODULE CheckPe64Dep;

	TYPE Base* = EXTENSIBLE RECORD END;

	VAR value*: INTEGER;

	PROCEDURE (VAR r: Base) Answer* (): INTEGER, NEW, EXTENSIBLE;
	BEGIN RETURN 42 END Answer;

	PROCEDURE Dispatch* (VAR r: Base): INTEGER;
	BEGIN RETURN r.Answer() END Dispatch;

	PROCEDURE Twice* (n: INTEGER): INTEGER;
	BEGIN RETURN n * 2 END Twice;

	PROCEDURE Select* (n: INTEGER): INTEGER;
	BEGIN
		CASE n OF
		| 0: RETURN 10 | 1: RETURN 11 | 2: RETURN 12 | 3: RETURN 13
		| 4: RETURN 14 | 5: RETURN 15 | 6: RETURN 16 | 7: RETURN 17
		| 8: RETURN 18 | 9: RETURN 19 | 10: RETURN 20 | 11: RETURN 21
		ELSE RETURN -1
		END
	END Select;

BEGIN
	INC(value, 21)
END CheckPe64Dep.
