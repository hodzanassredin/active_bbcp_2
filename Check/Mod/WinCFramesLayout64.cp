MODULE CheckWinCFramesLayout64;

	IMPORT SYSTEM, WinApi;

	CONST
		checkDRAWITEMSTRUCT = 1 DIV (1 DIV (1 + ABS(SIZE(WinApi.DRAWITEMSTRUCT) - 64)));
		checkMEASUREITEMSTRUCT = 1 DIV (1 DIV (1 + ABS(SIZE(WinApi.MEASUREITEMSTRUCT) - 32)));
		checkSCROLLINFO = 1 DIV (1 DIV (1 + ABS(SIZE(WinApi.SCROLLINFO) - 28)));

END CheckWinCFramesLayout64.
