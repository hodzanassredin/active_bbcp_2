	PROCEDURE Group16;
		VAR s, c: REAL;
	BEGIN
		Test("Sin.negativezero", Bool(Math.SignBit(Math.Sin(Value(MIN(INTEGER), 0)))), 1.);
		Test("Tan.negativezero", Bool(Math.SignBit(Math.Tan(Value(MIN(INTEGER), 0)))), 1.);
		Test("ArcSin.negativezero", Bool(Math.SignBit(Math.ArcSin(Value(MIN(INTEGER), 0)))), 1.);
		Test("ArcTan.negativezero", Bool(Math.SignBit(Math.ArcTan(Value(MIN(INTEGER), 0)))), 1.);
		Test("Sinh.negativezero", Bool(Math.SignBit(Math.Sinh(Value(MIN(INTEGER), 0)))), 1.);
		Test("Tanh.negativezero", Bool(Math.SignBit(Math.Tanh(Value(MIN(INTEGER), 0)))), 1.);
		Test("ArcSinh.negativezero", Bool(Math.SignBit(Math.ArcSinh(Value(MIN(INTEGER), 0)))), 1.);
		Test("ArcTanh.negativezero", Bool(Math.SignBit(Math.ArcTanh(Value(MIN(INTEGER), 0)))), 1.);
		Test("Trunc.negativezero", Bool(Math.SignBit(Math.Trunc(Value(MIN(INTEGER), 0)))), 1.);
		Test("Sign.negativezero", Bool(Math.SignBit(Math.Sign(Value(MIN(INTEGER), 0)))), 1.);
		Test("Mantissa.negativezero", Bool(Math.SignBit(Math.Mantissa(Value(MIN(INTEGER), 0)))), 1.);
		Test("CopySign.negativezero", Bool(Math.SignBit(Math.CopySign(0., -1.))), 1.);
		Test("Pi", Math.Pi(), 3.141592653589793);
		Test("Eps", Math.Eps(), 2.220446049250313E-16);
	END Group16;

	PROCEDURE Run*;
		VAR i: INTEGER; x: REAL;
	BEGIN
		count := 0; failures := 0; name := "";
		Group0;
		Group1;
		Group2;
		Group3;
		Group4;
		Group5;
		Group6;
		Group7;
		Group8;
		Group9;
		Group10;
		Group11;
		Group12;
		Group13;
		Group14;
		Group15;
		Group16;
		Test("IsNaN.inf", Bool(Math.IsNaN(INF)), 0.);
		Test("IsNaN.finite", Bool(Math.IsNaN(1.)), 0.);
		Test("SignBit.negativezero", Bool(Math.SignBit(Value(MIN(INTEGER), 0))), 1.);
		Test("SignBit.positivezero", Bool(Math.SignBit(0.)), 0.);
		FOR i := -1074 TO 1023 DO
			x := Math.Real(1., i);
			Test("Exponent.power2", Math.Exponent(x), i);
			Test("Mantissa.power2", Math.Mantissa(x), 1.);
			Test("Real.roundtrip", Math.Real(Math.Mantissa(-x), Math.Exponent(-x)), -x)
		END;
		FOR i := 0 TO 99 DO
			x := Math.IntPower(1., MIN(INTEGER)); Test("IntPower.MIN", x, 1.);
			Test("x87 balance", Math.Sqrt(4.), 2.)
		END
	END Run;

END CheckMath64.
