MODULE Crypto_devPSS;
(** Тесты RSASSA-PSS: векторы Wycheproof и подпись/проверка своим ключом.

	Открытый ключ Wycheproof (2048 бит, SHA-256, соль 32) проверяет две
	годные подписи и отвергает испорченную и подпись с солью длины 0.
	Отрицательные векторы pss-negative.txt (свой ключ 1024 бита) собирают
	EM с одним дефектом и подписывают его: разделитель 0x00/0x02,
	ненулевой PS, концевой 0xBB, старший бит maskedDB, соль 31/33.
	Для подписи генерируется ключ 1024 бита; проверяются SHA-256 и
	SHA-384, совпадение и отказ при подмене подписи и хеша. *)

	IMPORT CryptoPSS, CryptoRSA, CryptoPrimes, CryptoHashes, CryptoUtils,
		B := CryptoAosBigNumbers, UnitAssert;

	PROCEDURE StrLen (IN s: ARRAY OF SHORTCHAR): INTEGER;
		VAR i: INTEGER;
	BEGIN
		i := 0; WHILE s[i] # 0X DO INC(i) END; RETURN i
	END StrLen;

	PROCEDURE HexTo (IN hex: ARRAY OF SHORTCHAR; VAR buf: ARRAY OF SHORTCHAR): INTEGER;
		VAR len: INTEGER;
	BEGIN
		len := StrLen(hex) DIV 2;
		CryptoUtils.Hex2Bin(hex, 0, buf, 0, len);
		RETURN len
	END HexTo;

	PROCEDURE HexToAt (IN hex: ARRAY OF SHORTCHAR; VAR buf: ARRAY OF SHORTCHAR; ofs: INTEGER): INTEGER;
		VAR len: INTEGER;
	BEGIN
		len := StrLen(hex) DIV 2;
		CryptoUtils.Hex2Bin(hex, 0, buf, ofs, len);
		RETURN len
	END HexToAt;

	PROCEDURE HashBytes (IN modname: ARRAY OF SHORTCHAR; IN data: ARRAY OF SHORTCHAR;
			len: INTEGER; VAR out: ARRAY OF SHORTCHAR): INTEGER;
		VAR h: CryptoHashes.Hash;
	BEGIN
		h := CryptoHashes.NewHash(modname);
		h.Initialize;
		h.Update(data, 0, len);
		h.GetHash(out, 0);
		RETURN h.size
	END HashBytes;

	PROCEDURE VerifyHex (key: CryptoRSA.Key; IN hashName: ARRAY OF SHORTCHAR;
			IN msg: ARRAY OF SHORTCHAR; msgLen: INTEGER;
			IN sigHex: ARRAY OF SHORTCHAR; expected: BOOLEAN; IN what: ARRAY OF CHAR);
		VAR digest: ARRAY 64 OF SHORTCHAR; sig: ARRAY 300 OF SHORTCHAR;
			hLen, len: INTEGER;
	BEGIN
		hLen := HashBytes(hashName, msg, msgLen, digest);
		len := HexTo(sigHex, sig);
		UnitAssert.True(CryptoPSS.VerifyHash(hashName, digest, hLen, key,
			sig, 0, len) = expected, what)
	END VerifyHex;

	PROCEDURE TestWycheproof*;
		VAR key: CryptoRSA.Key; msg: ARRAY 300 OF SHORTCHAR;
			buf: ARRAY 300 OF SHORTCHAR; m, e: B.BigNumber;
			msgLen, pos, n: INTEGER;
	BEGIN
		pos := 0;
		n := HexToAt("A2B451A07D0AA5F96E455671513550514A8A5B462EBEF717094FA1FEE82224E637F9746D3F7CAFD31878D80325B6EF5A1700F65903B469429E89D6EAC8845097", buf, pos);
		INC(pos, n);
		n := HexToAt("B5AB393189DB92512ED8A7711A1253FACD20F79C15E8247F3D3E42E46E48C98E254A2FE9765313A03EFF8F17E1A029397A1FA26A8DCE26F490ED81299615D981", buf, pos);
		INC(pos, n);
		n := HexToAt("4C22DA610428E09C7D9658594266F5C021D0FCECA08D945A12BE82DE4D1ECE6B4C03145B5D3495D4ED5411EB878DAF05FD7AFC3E09ADA0F1126422F590975A19", buf, pos);
		INC(pos, n);
		n := HexToAt("69816F48698BCBBA1B4D9CAE79D460D8F9F85E7975005D9BC22C4E5AC0F7C1A45D12569A62807D3B9A02E5A530E773066F453D1F5B4C2E9CF7820283F742B9D5", buf, pos);
		INC(pos, n);
		B.AssignBin(m, buf, 0, pos);
		n := HexToAt("010001", buf, 0);
		B.AssignBin(e, buf, 0, n);
		key := CryptoRSA.PubKey(e, m);

		msgLen := 0;
		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"4F01E0C12B08625ECAC89A69231906EDF826380F37C959A96690D046316D68FF" +
			"CE9D5C471694FCEBFC6B45534864689256E4FC81C78E583F675D0C94B4496474" +
			"51E81BEFF01A11A516D5E5CE3F1A910437CB8A3A5096B19FB15F4524A35B23D8" +
			"9CDBA12CF5B71AAC1047B28C562DF7C5542C34CE23A182CF7E0E231934B17294" +
			"799D44877A1D68EF1B8F073619B7618E6B7C22DB20030D98CF591FFC3D4DA5F5" +
			"8613ECD5ECFC3B40A1D02F40891CA43695CD4C088B05A8054C89C595A47E2748" +
			"16F35384226F74459EE63E25A1BFC03C360490552EC38343F8ACE502F065303B" +
			"00BC0EC320711B211FDE92E57FEB9013C3609342495EC0D7CABDEC21E54ACC38",
			TRUE, "Wycheproof PSS valid empty message");

		msgLen := HexTo("0000000000000000000000000000000000000000", msg);
		VerifyHex(key, "CryptoSHA256", msg, 20,
			"0658C68FE0895646056D9BCA422A64FE48813B4E14F0C8C4122E56D345B6813D" +
			"C6286FFDE014617E351C7AF0A0D2C0F285DEF79CB734E1E055A25FA6FDDC1C07" +
			"DA17B4B235C637413B1849C24311FA72331F4C0458C364A4916DE8619B884D7E" +
			"37288FAD12926FC091F4851686A04FD0A504DBCE3DB370663A6EA6128FEA86C2" +
			"CA94C63E0D34D7F2C845B5D71D9A5E544451F524A451ACB85C49BBA7864E0A34" +
			"A48613A819CAF3DFD0D510C940F1DF21C3373915BE1F3509A557FA4D5A4E9F27" +
			"3E85467961133E2482C0907386454228FB0246638616FC31BBB6FA7C2361B803" +
			"5994EEC69A923F4C0BB0BA8696DFE8B1400C2398D7B343FDF498B1116C8DE602",
			TRUE, "Wycheproof PSS valid 20-byte message");

		msgLen := HexTo("313233343030", msg);
		VerifyHex(key, "CryptoSHA256", msg, 6,
			"67D1D1C0A398148625317C3F5E44B738BDF461C27A59594B39EBB2AEBEF233C7" +
			"809379E54411411B82D2E7AC88F989B58373D532C758BAEA121878CE97594417" +
			"38D121881C1FA2D04421F02DD565B12770D844611ED1873A0B64D822709A6B78" +
			"D6D3892B294404BCE6711001D6C3A54546C76A1D17819674B0BE904497A233B4" +
			"66FE4BECC832DEE740F9AB79E5B9F5DB0B0F9AAC0084BA05CEBF42303B5CA2AD" +
			"95E3D61B29ED6475545C02E93E7B0E118AF92F5CDDB1FAEB2CBC23C9E69C120E" +
			"29DF7FE31991E887B3B29E77688C60E80BE65CCCF3D7861A7A14C39E6A6E5645" +
			"568E2CC5E4A17B75DB1DD415AADB45E112A9B582B2FF6E82A43D7A7347B7B56D",
			FALSE, "Wycheproof PSS rejects modified m_hash");

		VerifyHex(key, "CryptoSHA256", msg, 6,
			"5E91B5DCBF02D6F19621D41A83DC8F15EA83C0EDB83765EF029B0ACAC2E1EC89" +
			"18B1D2AFE1FADF11C48D27594CB9C01FED79D90E5D5A8085C438450111AA7D9F" +
			"A39C2345B14FC3C2CB34128F86DB5EB00BDF8DFE38D61F29A41FE31342E7AAEF" +
			"CB4B122EB5D63C2F5C263C8DF8450E9428FFEF974D535818D51DC03A7D60C8B2" +
			"D16C999AE46D73AB40515FE601D9B89B1D09C6D60CD51639A97C1D211E097609" +
			"BA5E8C319C6FBD21B34A634EC8FB8971C5AAE21C70B847A4539CC10DC314DDD8" +
			"A9629E8A0E51C66C0CB61FD1F7228C01C6769190ABE9BAC9A389780005001435" +
			"8594E0FB20DBB458B12AA1346826CC9F7E9C5352B073D62853DAFE77C848CB1F",
			FALSE, "Wycheproof PSS rejects salt length 0")
	END TestWycheproof;

	PROCEDURE TestNegativeEncoding*;
	(* Отрицательные векторы Crypto_dev/Vectors/pss-negative.txt:
	   EM собран с одним дефектом и подписан настоящим ключом
	   (s = EM^d mod n). Проверка обязана отвергнуть всё, кроме
	   контрольного вектора. Дефекты: разделитель 0x00/0x02 вместо
	   0x01, ненулевой PS, концевой 0xBB вместо 0xBC, старший бит
	   maskedDB, соль длины 31 и 33. *)
		VAR key: CryptoRSA.Key; n, e: B.BigNumber;
			msg: ARRAY 16 OF SHORTCHAR; buf: ARRAY 300 OF SHORTCHAR;
			msgLen, len: INTEGER;
	BEGIN
		len := HexTo("EB40A4AB9289BA3445A468DF299113538D056AD6042B118B6ACA0C7471CD0567" +
			"9AFFE121B4B561B16CE730CB23BE217D751F1282B495F6BC9214F89FF0ACE1BE" +
			"7D7105D17BB21D03879636480DA6F514F60F76CD81B7D176E09D3144218DCE7F" +
			"3EC22D4959D37BF69E917BF309E93B568D47239D6A1F8C21291450C47BAB32C1", buf);
		B.AssignBin(n, buf, 0, len);
		len := HexTo("010001", buf);
		B.AssignBin(e, buf, 0, len);
		key := CryptoRSA.PubKey(e, n);
		msgLen := HexTo("6E6567617469766520505353", msg);

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"ABDFD4F5A11BBCF3BDA0BA7A1D45BA2F07B59FED2B9B9BFB20F2F93018BE1791" +
			"55FC3C234340D01589C1CD15C54445A51F54649B455FEBE4B9E1390C5F097EA0" +
			"12404788C583EA2F94E8BE59BD237A025E86B9BFD5807A6726CDE281E2DC767A" +
			"C33308668DE008298F8CE69A4FB6662C4BBB36FC3EAABBCF11EB11F0D095C053",
			TRUE, "PSS control vector verifies");

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"2BC1AB6F444E9AA74B034916FF8AB5721285D4B170DB480B255206FB51BF080D" +
			"5ABB8B885929D5F0761ACFCA0091ECCEED422EA22451ED98187AB98499DBC14D" +
			"FD5692216ECC4C1C158EA6596CEC8F84A0AD76E201D55E8156E948577F9DDC2C" +
			"8E736829C54D1F4DBC74C98683982E73E798E6F677323C4D33A4DD504A59154F",
			FALSE, "PSS rejects separator 0x00");

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"8C51BE5F2A45382BF94C377186C1B4807BFA6F486FFF4D3574797C44EA409EEA" +
			"DBB5F7DE7C6D837678F4B6E260AD840CE74D78374E39AB3923F349E3203729E9" +
			"5D533EAFA0E5A5C1AEF356008F5F6E9ADA2AF8ADA10DB97C50B1F11385EE7304" +
			"4E38D71982B459E862D7754413C89F98C8C11A6AEF5B4DE47338A09F48AAE1D7",
			FALSE, "PSS rejects separator 0x02");

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"8D689885B0F7B707CCFAA13DA636EA140E4E9DCE8A33200FEB51AD46F8614A9C" +
			"9319EF25C99311AB557724BF9096D0AA9DCEA68EE1F11FC57863F53052090CF5" +
			"9F33790EECA5C8443F2EB3B9506BD62EDD0CE35C2EE6464F1B1CFDB0C2917B97" +
			"7F1D2D9074DFF93F35006F47B9254B00D92CFAE942E5FB3CF1FBA407E4B15937",
			FALSE, "PSS rejects nonzero PS octet");

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"098F7C14209D01A72E31908B51DC18E352C9092EDB707A34F50A4256DD008B6A" +
			"6357A305D29E8BF449DB8A14180B918E54C0C13550B503DCB6D5005E64958B29" +
			"5FA15654FBF0D65CC894A30B3E918BC92796C1B461E5D22CF84675A7DC77580D" +
			"175CA58581BDCE419BC3252C894775E68D41804DA718CC9F45A0FFF8474C9570",
			FALSE, "PSS rejects trailer 0xBB");

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"E7668C1336A65D1047CA93386C62B35D02D28254B5AC0ECA12B166808655A5E7" +
			"39BF8A50F1C62CFFAE92F120AE94001928592D331C1B53417DA30B1894876858" +
			"C2214D3D44F01CDE091BB5F716DA0D69E3E20A194668AD0831E732DE3CE6DD3C" +
			"47FAD21C70A8EE614733EFDD997D5371F6809125AED9D1E55F4CA6411A95F794",
			FALSE, "PSS rejects nonzero maskedDB top bit");

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"AB639EAD4C28095E4345C2F65B028164C3E2D50EFE39B90BC03E424B62E2E76B" +
			"69AF8587C23E1F6D4BCC485C183C05632877CFF9A74C1B6DE7C93479D5E75316" +
			"BD4E1B121D7397DD1564C353583CD49198506F75564DA2C7D1737F0F8F70CFA9" +
			"974786BD9B3F68E4471000598EBC480A0C280AC56F084D18E2EB31ABA503907B",
			FALSE, "PSS rejects salt length 31");

		VerifyHex(key, "CryptoSHA256", msg, msgLen,
			"DB225A66F7FA68680410583CA966F3786E387C9DA970541724FBBD59B7166962" +
			"F865307D94FB8A217AA6F0C210118A82DA3E6AC1344BEECA81AE62E461C39099" +
			"96436F2582463ACC06558B0C6E9985B2014681B41D719F2AC7FA6EF6DE82E8E" +
			"2D33AFA6CE94A75B6D2CB79BBE6BC04B724D2EF64B04233B2598563C17AF7266C",
			FALSE, "PSS rejects salt length 33")
	END TestNegativeEncoding;

	PROCEDURE TestSign*;
		VAR p, q, e: B.BigNumber; pub, priv: CryptoRSA.Key;
			digest: ARRAY 64 OF SHORTCHAR; sig: ARRAY 256 OF SHORTCHAR;
			sigLen, hLen, i: INTEGER;
	BEGIN
		p := CryptoPrimes.NewPrime(512, FALSE);
		q := CryptoPrimes.NewPrime(512, FALSE);
		B.AssignInt(e, 65537);
		CryptoRSA.MakeKeys(p, q, e, "PSS test", pub, priv);
		FOR i := 0 TO 31 DO digest[i] := SHORT(CHR(i)) END;
		CryptoPSS.SignHash("CryptoSHA256", digest, 32, priv, sig, 0, sigLen);
		UnitAssert.EqualInt(128, sigLen, "PSS signature length");
		UnitAssert.True(CryptoPSS.VerifyHash("CryptoSHA256", digest, 32,
			pub, sig, 0, sigLen), "PSS own signature verifies");
		sig[0] := SHORT(CHR(ORD(sig[0]) + 1));
		UnitAssert.True(~CryptoPSS.VerifyHash("CryptoSHA256", digest, 32,
			pub, sig, 0, sigLen), "PSS rejects changed signature");
		sig[0] := SHORT(CHR(ORD(sig[0]) - 1));
		digest[0] := SHORT(CHR(ORD(digest[0]) + 1));
		UnitAssert.True(~CryptoPSS.VerifyHash("CryptoSHA256", digest, 32,
			pub, sig, 0, sigLen), "PSS rejects changed hash");

		digest[0] := SHORT(CHR(ORD(digest[0]) - 1));
		hLen := HashBytes("CryptoSHA384", "pss sha384", 10, digest);
		CryptoPSS.SignHash("CryptoSHA384", digest, hLen, priv, sig, 0, sigLen);
		UnitAssert.True(CryptoPSS.VerifyHash("CryptoSHA384", digest, hLen,
			pub, sig, 0, sigLen), "PSS SHA-384 own signature verifies")
	END TestSign;

END Crypto_devPSS.
