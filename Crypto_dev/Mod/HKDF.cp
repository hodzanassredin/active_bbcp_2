MODULE Crypto_devHKDF;
(** Тесты HKDF (RFC 5869) и HKDF на SHA-384/SHA-512.

	Векторы RFC 5869 (SHA-256) и независимо посчитанные значения для
	SHA-512; проверяются Extract, Expand и границы длины выхода. *)

	IMPORT CryptoHKDF, CryptoUtils, UnitAssert;

	PROCEDURE Equal (IN a, b: ARRAY OF SHORTCHAR; len: INTEGER): BOOLEAN;
		VAR i: INTEGER;
	BEGIN
		i := 0;
		WHILE (i < len) & (a[i] = b[i]) DO INC(i) END;
		RETURN i = len
	END Equal;

	PROCEDURE CheckHex (IN got, hex: ARRAY OF SHORTCHAR; len: INTEGER; IN msg: ARRAY OF CHAR);
		VAR want: ARRAY 128 OF SHORTCHAR;
	BEGIN
		CryptoUtils.Hex2Bin(hex, 0, want, 0, len);
		UnitAssert.True(Equal(got, want, len), msg)
	END CheckHex;

	PROCEDURE TestRFC5869Case1*;
		VAR ikm, salt, info, prk, okm: ARRAY 128 OF SHORTCHAR;
	BEGIN
		CryptoUtils.Hex2Bin("0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B", 0, ikm, 0, 22);
		CryptoUtils.Hex2Bin("000102030405060708090A0B0C", 0, salt, 0, 13);
		CryptoUtils.Hex2Bin("F0F1F2F3F4F5F6F7F8F9", 0, info, 0, 10);
		CryptoHKDF.Extract("CryptoSHA256", salt, 13, ikm, 22, prk);
		CheckHex(prk, "077709362C2E32DF0DDC3F0DC47BBA6390B6C73BB50F9C3122EC844AD7C2B3E5",
			32, "HKDF-SHA256 RFC 5869 case 1 PRK");
		UnitAssert.True(CryptoHKDF.Expand("CryptoSHA256", prk, 32, info, 10, okm, 42),
			"HKDF-SHA256 case 1 Expand succeeds");
		CheckHex(okm, "3CB25F25FAACD57A90434F64D0362F2A2D2D0A90CF1A5A4C5DB02D56ECC4C5BF" +
			"34007208D5B887185865", 42, "HKDF-SHA256 RFC 5869 case 1 OKM")
	END TestRFC5869Case1;

	PROCEDURE TestRFC5869Case2*;
		VAR ikm, salt, info, prk, okm: ARRAY 128 OF SHORTCHAR;
	BEGIN
		CryptoUtils.Hex2Bin("000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F" +
			"202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F" +
			"404142434445464748494A4B4C4D4E4F", 0, ikm, 0, 80);
		CryptoUtils.Hex2Bin("606162636465666768696A6B6C6D6E6F707172737475767778797A7B7C7D7E7F" +
			"808182838485868788898A8B8C8D8E8F909192939495969798999A9B9C9D9E9F" +
			"A0A1A2A3A4A5A6A7A8A9AAABACADAEAF", 0, salt, 0, 80);
		CryptoUtils.Hex2Bin("B0B1B2B3B4B5B6B7B8B9BABBBCBDBEBFC0C1C2C3C4C5C6C7C8C9CACBCCCDCECF" +
			"D0D1D2D3D4D5D6D7D8D9DADBDCDDDEDFE0E1E2E3E4E5E6E7E8E9EAEBECEDEEEF" +
			"F0F1F2F3F4F5F6F7F8F9FAFBFCFDFEFF", 0, info, 0, 80);
		CryptoHKDF.Extract("CryptoSHA256", salt, 80, ikm, 80, prk);
		CheckHex(prk, "06A6B88C5853361A06104C9CEB35B45CEF760014904671014A193F40C15FC244",
			32, "HKDF-SHA256 RFC 5869 case 2 PRK");
		UnitAssert.True(CryptoHKDF.Expand("CryptoSHA256", prk, 32, info, 80, okm, 82),
			"HKDF-SHA256 case 2 Expand succeeds");
		CheckHex(okm, "B11E398DC80327A1C8E7F78C596A49344F012EDA2D4EFAD8A050CC4C19AFA97C" +
			"59045A99CAC7827271CB41C65E590E09DA3275600C2F09B8367793A9ACA3DB71" +
			"CC30C58179EC3E87C14C01D5C1F3434F1D87", 82, "HKDF-SHA256 RFC 5869 case 2 OKM")
	END TestRFC5869Case2;

	PROCEDURE TestRFC5869Case3*;
		VAR ikm, salt, info, prk, okm: ARRAY 128 OF SHORTCHAR;
	BEGIN
		CryptoUtils.Hex2Bin("0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B", 0, ikm, 0, 22);
		CryptoHKDF.Extract("CryptoSHA256", salt, 0, ikm, 22, prk);
		CheckHex(prk, "19EF24A32C717B167F33A91D6F648BDF96596776AFDB6377AC434C1C293CCB04",
			32, "HKDF-SHA256 RFC 5869 case 3 PRK");
		UnitAssert.True(CryptoHKDF.Expand("CryptoSHA256", prk, 32, info, 0, okm, 42),
			"HKDF-SHA256 case 3 Expand succeeds");
		CheckHex(okm, "8DA4E775A563C18F715F802A063C5A31B8A11F5C5EE1879EC3454E5F3C738D2D" +
			"9D201395FAA4B61A96C8", 42, "HKDF-SHA256 RFC 5869 case 3 OKM")
	END TestRFC5869Case3;

	PROCEDURE TestSHA512*;
		VAR ikm, salt, info, prk, okm: ARRAY 128 OF SHORTCHAR;
	BEGIN
		CryptoUtils.Hex2Bin("0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B", 0, ikm, 0, 22);
		CryptoUtils.Hex2Bin("000102030405060708090A0B0C", 0, salt, 0, 13);
		CryptoUtils.Hex2Bin("F0F1F2F3F4F5F6F7F8F9", 0, info, 0, 10);
		CryptoHKDF.Extract("CryptoSHA512", salt, 13, ikm, 22, prk);
		CheckHex(prk, "665799823737DED04A88E47E54A5890BB2C3D247C7A4254A8E61350723590A26" +
			"C36238127D8661B88CF80EF802D57E2F7CEBCF1E00E083848BE19929C61B4237",
			64, "HKDF-SHA512 PRK");
		UnitAssert.True(CryptoHKDF.Expand("CryptoSHA512", prk, 64, info, 10, okm, 42),
			"HKDF-SHA512 Expand succeeds");
		CheckHex(okm, "832390086CDA71FB47625BB5CEB168E4C8E26A1A16ED34D9FC7FE92C14815793" +
			"38DA362CB8D9F925D7CB", 42, "HKDF-SHA512 OKM");
		UnitAssert.True(CryptoHKDF.HKDF("CryptoSHA512", salt, 13, ikm, 22, info, 10, okm, 42),
			"HKDF-SHA512 one-shot succeeds");
		CheckHex(okm, "832390086CDA71FB47625BB5CEB168E4C8E26A1A16ED34D9FC7FE92C14815793" +
			"38DA362CB8D9F925D7CB", 42, "HKDF-SHA512 one-shot output")
	END TestSHA512;

	PROCEDURE TestBounds*;
		VAR prk, salt, ikm, okm: ARRAY 128 OF SHORTCHAR;
	BEGIN
		ikm := "key material";
		CryptoHKDF.Extract("CryptoSHA256", salt, 0, ikm, 12, prk);
		UnitAssert.True(~CryptoHKDF.Expand("CryptoSHA256", prk, 32, ikm, 0, okm, 129),
			"HKDF refuses output longer than the buffer")
	END TestBounds;

END Crypto_devHKDF.
